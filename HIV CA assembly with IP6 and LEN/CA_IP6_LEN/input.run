variable TEMP           equal   300.0

variable PRESS 		equal   0.0
#variable SEEGD  		equal  	999
variable SEED2   	equal   $( v_SEED + 1099 )
variable SEED3  	equal   $( v_SEED + 80192 ) 
variable SEED4  	equal   $( v_SEED + 7102 )
variable SEED5 		equal   $( v_SEED + 30192 )

include 	"system.init"
read_data 	"len.data" add append offset 140 815 0  0 0
read_data	"eq.data" extra/atom/types 7 extra/bond/types 0 extra/angle/types 0 extra/bond/per/atom 0 extra/angle/per/atom 0

include		"system.settings"

group          active type 131 132 133 134
group          CA type < 139
group          CRO type 139
group          IP type 140
group          LEN type 141 142 143 144 145 146 147

fix r1         LEN rigid molecule

#molecule         GS gs.txt

#create_atoms     0 region cell mol GS 100 units box
#fix c            all deposit 200 0 10 12345 region cell near 1.0 mol GS units box

timestep        10.0
comm_style 	tiled
comm_modify	mode single cutoff 40.0
compute 	1 all pair srlr_gauss

#minimize 	1.0e-4 1.0e-6 100 1000

fix 	1  all    nve
fix 	2  all    langevin ${TEMP} ${TEMP} 100000.0 ${SEED3} zero yes
fix 	b1 all balance 25000 1.05 rcb


# this is my UCG switching fix
# source: fix_cluster_switch.cpp
# params: cluster_switch [molID of reference to determine cluster] [offset molID (since we have a dimer)]
#          [distance metric to count mols in contact] [random seed] 
#          rateFreq [number of steps before switching]
#	   rateFile [name of rate file]
#	   contactFile [name of contact file]

fix 3  	all    cluster_switch CID 0 20.0 ${SEED2} rateFreq 500000 rateFile rates15.txt contactFile contacts.txt

thermo 50000
thermo_style  custom  step spcpu  temp  ke pe etotal  epair c_1 lx ly lz  pxx pyy pzz f_3[1] f_3[2] f_3[3] f_3[4] f_3[5] f_3[6] f_3[7]

dump 		1 all atom 500000 dump_SID.lammpstrj
dump_modify 	1 sort id

run 100000000

write_dump 	all atom eq_SID.lammpstrj
write_data 	eq_SID.data nocoeff

